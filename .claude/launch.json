{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "palestra-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "palestra-iphone",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--lan",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "palestra-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-dist.mjs",
        "app-palestra",
        "8088"
      ],
      "port": 8088
    }
  ]
}
